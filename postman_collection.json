{
	"info": {
		"name": "Bot Kuliner API",
		"description": "RESTful API untuk Bot Telegram Kuliner dengan Laravel",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "user_id",
			"value": ""
		},
		{
			"key": "restaurant_id",
			"value": "dummy-1"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"url": "{{base_url}}/auth/register",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"url": "{{base_url}}/auth/login",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
						}
					}
				},
				{
					"name": "Enable 2FA",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"url": "{{base_url}}/auth/2fa/enable"
					}
				},
				{
					"name": "Verify 2FA",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"url": "{{base_url}}/auth/2fa/verify",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"code\": \"123456\"\n}"
						}
					}
				},
				{
					"name": "Disable 2FA",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"url": "{{base_url}}/auth/2fa/disable",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"password\": \"password123\"\n}"
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{access_token}}"}
						],
						"url": "{{base_url}}/auth/logout"
					}
				}
			]
		},
		{
			"name": "Restaurants",
			"item": [
				{
					"name": "Search Restaurants",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
						"url": {
							"raw": "{{base_url}}/restaurants?q=nasi&city=jakarta",
							"host": ["{{base_url}}"],
							"path": ["restaurants"],
							"query": [
								{"key": "q", "value": "nasi"},
								{"key": "city", "value": "jakarta"}
							]
						}
					}
				},
				{
					"name": "Get Restaurant Detail",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
						"url": "{{base_url}}/restaurants/{{restaurant_id}}"
					}
				},
				{
					"name": "Get Restaurant Menu",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
						"url": "{{base_url}}/restaurants/{{restaurant_id}}/menu"
					}
				},
				{
					"name": "Get Restaurant Reviews",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
						"url": "{{base_url}}/restaurants/{{restaurant_id}}/reviews"
					}
				}
			]
		},
		{
			"name": "Telegram",
			"item": [
				{
					"name": "Webhook",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"url": "{{base_url}}/telegram/webhook",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"update_id\": 123456,\n  \"message\": {\n    \"message_id\": 1,\n    \"chat\": {\"id\": 123456789},\n    \"date\": 1234567890,\n    \"text\": \"nasi goreng\"\n  }\n}"
						}
					}
				}
			]
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Get Audit Logs",
					"request": {
						"method": "GET",
						"header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
						"url": {
							"raw": "{{base_url}}/admin/audit-logs?per_page=20",
							"host": ["{{base_url}}"],
							"path": ["admin", "audit-logs"],
							"query": [{"key": "per_page", "value": "20"}]
						}
					}
				}
			]
		}
	]
}
